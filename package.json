{
  "name": "glyphquire",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @glyphquire/api test:integration && pnpm --filter @glyphquire/queue test:integration",
    "test:integration:release": "vitest run --config tests/integration/vitest.config.ts tests/integration/release-checklist.test.ts tests/integration/release-deployment.test.ts tests/integration/release-preflight-route.test.ts tests/integration/release-backup-restore.test.ts tests/integration/release-screen-reader-evidence.test.ts tests/integration/release-gate.test.ts",
    "test:integration:release-observability": "bash infra/observability/release-observability-test.sh",
    "test:release": "bash infra/release/release-gate.sh",
    "test:cross-package": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:operations:alerting": "vitest run --config tests/integration/vitest.config.ts tests/integration/operations-alerting.test.ts",
    "test:load:autosave": "tsx tests/load/autosave-conflict.ts",
    "test:load:workspace": "tsx tests/load/workspace-load.ts",
    "test:load:release-environment": "tsx tests/load/release-environment.ts",
    "test:performance:release": "sh -c 'if [ \"${1:-}\" = \"--\" ]; then shift; fi; exec playwright test tests/performance/release.perf.spec.ts --project=performance \"$@\"' --",
    "test:browserstack:release": "tsx tests/e2e/release-browserstack.ts --sdk-config configs/release-browserstack.yml --matrix configs/release-browser-matrix.json --spec tests/e2e/release-browser-matrix.spec.ts --evidence docs/evidence/release/browser-matrix.json",
    "test:quality-gate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm -r test && pnpm test:cross-package && pnpm test:integration && pnpm test:e2e",
    "lint": "oxlint --config .oxlintrc.json --vue-plugin .",
    "lint:fix": "oxlint --config .oxlintrc.json --vue-plugin --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:generate": "pnpm --filter @glyphquire/database generate",
    "db:verify-baseline": "pnpm --filter @glyphquire/database db:verify-baseline",
    "db:migrate": "pnpm --filter @glyphquire/database migrate",
    "db:upgrade:compose": "docker compose --profile phase0-upgrade run --rm postgres-phase0-role-upgrade",
    "db:preflight:roles-compose": "docker compose --profile phase0-upgrade run --rm postgres-role-preflight",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "browserstack-node-sdk": "1.68.0",
    "happy-dom": "^20.11.6",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unified": "11.0.5",
    "vitest": "^5.0.0",
    "vue": "^3.5.0"
  }
}
