{
  "name": "glyphquire",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @glyphquire/api test:integration && pnpm --filter @glyphquire/queue test:integration",
    "test:integration:phase6": "vitest run --config /dev/null tests/integration/phase6-release-checklist.test.ts tests/integration/phase6-deployment.test.ts tests/integration/phase6-preflight-route.test.ts tests/integration/phase6-backup-restore.test.ts",
    "test:integration:phase6-observability": "sh infra/observability/phase6-observability-test.sh",
    "test:release:phase6": "sh infra/phase6/phase6-release-gate.sh",
    "test:cross-package": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:alerting:phase5": "vitest run --config /dev/null tests/integration/phase5-alerting.test.ts",
    "test:load:phase2": "tsx tests/load/autosave-conflict.ts",
    "test:load:phase5": "tsx tests/load/phase5-product-services.ts",
    "test:phase2": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm -r test && pnpm test:cross-package && pnpm test:integration && pnpm test:e2e",
    "lint": "oxlint --config .oxlintrc.json --vue-plugin .",
    "lint:fix": "oxlint --config .oxlintrc.json --vue-plugin --fix .",
    "lint:compat": "eslint .",
    "format": "oxfmt --write . && pnpm format:fallback",
    "format:check": "oxfmt --check . && pnpm format:fallback:check",
    "format:fallback": "prettier --write --no-error-on-unmatched-pattern 'docs/**/*.md' 'packages/**/*.md' 'apps/**/*.md' 'tests/**/*.md'",
    "format:fallback:check": "prettier --check --no-error-on-unmatched-pattern 'docs/**/*.md' 'packages/**/*.md' 'apps/**/*.md' 'tests/**/*.md'",
    "db:generate": "pnpm --filter @glyphquire/database generate",
    "db:verify-baseline": "pnpm --filter @glyphquire/database db:verify-baseline",
    "db:migrate": "pnpm --filter @glyphquire/database migrate",
    "db:upgrade:phase0-compose": "docker compose --profile phase0-upgrade run --rm postgres-phase0-role-upgrade",
    "db:preflight:roles-compose": "docker compose --profile phase0-upgrade run --rm postgres-role-preflight",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.28.0",
    "globals": "^16.1.0",
    "happy-dom": "^20.11.6",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.5.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "unified": "11.0.5",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  }
}
