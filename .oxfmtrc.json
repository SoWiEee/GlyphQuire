{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    ".superpowers/**",
    "README.md",
    "AGENTS.md",
    "packages/document-engine/tests/fixtures/**",
    "packages/database/src/migrations/meta/**"
  ]
}
